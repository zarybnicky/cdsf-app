{
  "name": "cdsf-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "expo:check": "expo install --check",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build:android:dev": "eas build --platform android --profile development --local",
    "build:android:preview": "eas build --platform android --profile preview --local",
    "build:android:store": "eas build --platform android --profile production --local",
    "build:ios:store": "eas build --platform ios --profile production --local",
    "submit:android:preview": "eas submit --platform android --profile preview --path ./*.apk",
    "submit:ios:preview": "eas submit --platform ios --profile preview --path ./*.ipa",
    "submit:android:store": "eas submit --platform android --profile production --path ./app.aab",
    "submit:ios:store": "eas submit --platform ios --profile production --path ./app.ipa"
  },
  "dependencies": {
    "@expo/dom-webview": "^57.0.1",
    "@expo/metro-runtime": "^57.0.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5.97.0",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-query-persist-client": "^5.97.0",
    "expo": "~57.0.13",
    "expo-background-task": "~57.0.10",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.10",
    "expo-web-browser": "~57.0.2",
    "jotai": "^2.19.1",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-enriched-markdown": "^0.4.1",
    "react-native-mmkv": "^4.3.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.8.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
