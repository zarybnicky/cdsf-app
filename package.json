{
  "name": "cdsf-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "expo:check": "expo install --check",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build:android:dev": "eas build --platform android --profile development --local",
    "build:android:preview": "eas build --platform android --profile preview --local",
    "build:android:store": "eas build --platform android --profile production --local",
    "build:ios:store": "eas build --platform ios --profile production --local",
    "submit:android": "eas submit --platform android --profile production --path ./app.aab",
    "submit:ios": "eas submit --platform ios --profile production --path ./app.ipa"
  },
  "dependencies": {
    "@expo/metro-runtime": "^56.0.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5.97.0",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-query-persist-client": "^5.97.0",
    "expo": "~56.0.19",
    "expo-background-task": "~56.0.25",
    "expo-constants": "~56.0.23",
    "expo-dev-client": "~56.0.24",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.16",
    "expo-notifications": "~56.0.23",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.25",
    "expo-web-browser": "~56.0.6",
    "jotai": "^2.19.1",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-enriched-markdown": "^0.4.1",
    "react-native-mmkv": "^4.3.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.8.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
